\hypertarget{projects}{%
\section{PROJECTS}\label{projects}}

\textbf{Credit Default Risk Prediction}

\begin{itemize}
\item
  Built a supervised credit default prediction model on customer
  financial and behavioural data, performing EDA and feature engineering
  such as income-to-loan and EMI-to-income ratios to capture repayment
  capacity better.
\item
  Modelled non-linear risk patterns using an artificial neural network
  instead of linear models, improving separation between defaulters and
  non-defaulters.
\item
  Evaluated model performance using ROC-AUC to address class imbalance
  and focus on risk ranking rather than raw accuracy while achieving
  ROC-AUC of \textbf{0.87} on test data.
\end{itemize}

\begin{quote}
\textbf{Financial Text Summarization \& Insight Generation (NLP + LLM)}
